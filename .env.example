# Spotify developer app (owner needs Spotify Premium, see README)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# live = call Spotify, mock = built-in track list (demo safety net)
SPOTIFY_MODE=live
# Host login. Must match a redirect URI in the Spotify dashboard. Use 127.0.0.1, not localhost.
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8080/api/auth/callback

DB_HOST=localhost
DB_PORT=3306
DB_USER=partay
DB_PASSWORD=partay

DATA_SERVER_HOST=localhost
DATA_SERVER_PORT=9090
